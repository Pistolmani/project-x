# Copy to .env (git-ignored) and fill in. On the HF Space, set the same names as Space secrets.

# Qdrant: local Docker by default; Qdrant Cloud URL + key in production
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LLM providers (used from Phase 2 on)
GEMINI_API_KEY=
GROQ_API_KEY=

APP_PORT=8000
STREAMLIT_PORT=8501
