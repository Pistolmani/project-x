# Paste into Streamlit Cloud -> app -> Settings -> Secrets (fill in the four keys from your .env).
# Top-level secrets become environment variables, which the backend's settings read.
QDRANT_URL = ""
QDRANT_API_KEY = ""
GEMINI_API_KEY = ""
GROQ_API_KEY = ""

MODEL_BACKEND = "onnx"   # no torch on the host
EMBEDDED_API = "true"    # Streamlit Cloud runs only `streamlit run`: start the API in-process
DEMO_MODE = "true"       # corpus and eval documents read-only for visitors
ASK_LIMIT_PER_HOUR = "60"
